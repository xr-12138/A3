# 环境与路径
ENV=development  # development | production
WORK_DIR=/home/hjj/桌面/A3-main

# 数据库（支持 sqlite 或完整 URL）
# sqlite 示例： sqlite:////home/hjj/桌面/A3-main/data/db.sqlite3
