PORT_API=8000
PORT_FRONTEND=8501

# 其他（可选）
SENTRY_DSN=
# 示例环境变量文件（不要在仓库中提交真实密钥）
# 复制此文件为 config/.env，然后填写真实值用于本地或生产环境。

# 讯飞（Xfyun）API 配置
# 说明：从讯飞开发者控制台获取对应的应用 ID、API Key 与 API Secret
XF_APP_ID=ef65c09d
XF_API_KEY=448cb5ff081bf64bd0b41d235055ddf6
XF_API_SECRET=ODlkMGFhOTVkNDJhYThiZTQ4MWYzODM3

# 应用环境：development / production / staging
ENV=development

# 服务端口（FastAPI）
API_HOST=0.0.0.0
API_PORT=8000

# 数据库（支持 sqlite/postgres/mysql）
# 示例 sqlite 路径（相对于项目根目录）：sqlite:///./data/db.sqlite3
DATABASE_URL=

# 缓存与会话目录（本地示例）
CACHE_DIR=/home/hjj/桌面/A3-main/data/cache
SESSION_DIR=/home/hjj/桌面/A3-main/data/sessions

# 媒体与生成文件默认目录
MEDIA_DIR=/home/hjj/桌面/A3-main/data/media
GENERATED_DIR=/home/hjj/桌面/A3-main/data/generated

# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# 外部服务与队列（可选）
REDIS_URL=redis://localhost:6379/0

# 其他配置（可扩展）
# 如需使用讯飞语音/多模态高级功能，可在此添加相关参数
